@PredictionLeague_HostAddress = http://localhost:5185

GET {{PredictionLeague_HostAddress}}/health/db
Accept: text/plain

###

### Leagues (S-03, S-04)
# All require the Identity auth cookie — sign in first via api/auth. Anonymous calls
# return 401. TournamentId must be a *published* tournament (GET api/tournaments lists them).

@LeagueId = 00000000-0000-0000-0000-000000000000
@TournamentId = 00000000-0000-0000-0000-000000000000

# Create a league. The rule set is a *selection*: list only the parameters that score, each at
# most once, Points 1..1000. A parameter that does not score is simply left out.
POST {{PredictionLeague_HostAddress}}/api/leagues
Content-Type: application/json

{
  "name": "Friday Night Pool",
  "tournamentId": "{{TournamentId}}",
  "scoringRules": [
    { "parameter": "ExactScore", "points": 3 },
    { "parameter": "CorrectOutcome", "points": 1 }
  ]
}

###

# Leagues the caller organizes or belongs to.
GET {{PredictionLeague_HostAddress}}/api/leagues
Accept: application/json

###

# League detail with invite code + scoring rules. 404 when the caller is not organizer or member.
# isScoringLocked is true once any match in the league's tournament has kicked off.
GET {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}
Accept: application/json

###

# Replace the league's scoring rules (organizer only). 403 for a member who is not the organizer,
# 404 for anyone else, 409 once the tournament has started.
PUT {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}/scoring-rules
Content-Type: application/json

{
  "scoringRules": [
    { "parameter": "ExactScore", "points": 5 },
    { "parameter": "CorrectGoalScorer", "points": 4 }
  ]
}

###

# Empty rule set — expect 400 "At least one scoring rule is required."
PUT {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}/scoring-rules
Content-Type: application/json

{
  "scoringRules": []
}

###

### League membership (S-05)
# The invite code is the only thing a joiner needs. MemberUserId is another member's userId,
# which GET api/leagues/{id} lists under "members".

@InviteCode = ABCDEFGH
@MemberUserId = 00000000-0000-0000-0000-000000000000

# Join by invite code. The code is normalized (trimmed + uppercased), so a lowercase code works.
# Joining twice returns 200 with the same detail — idempotent, not 409. Unknown or blank → 404.
POST {{PredictionLeague_HostAddress}}/api/leagues/join
Content-Type: application/json

{
  "inviteCode": "{{InviteCode}}"
}

###

# Leave the league. 404 when the caller is neither organizer nor member. 409 for the organizer
# while other members remain — transfer first. The *last* member to leave deletes the league.
DELETE {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}/membership

###

# Hand the league to another member (organizer only). 403 for a member who is not the organizer,
# 404 for anyone else, 400 when the target is the caller or is not a member of this league.
PUT {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}/organizer
Content-Type: application/json

{
  "userId": "{{MemberUserId}}"
}

###

### Predictions (S-06)
# All routes are member-facing: the caller must organize or belong to the league, else 404 — the
# same masking the league detail route uses, so membership never leaks.
#
# The kickoff lock is server-side: a match with KickoffUtc <= now is refused no matter who asks or
# how. The requests below are the direct-HTTP proof of that — the UI hiding an input is not.

@Round = Round 1
@MatchId = 00000000-0000-0000-0000-000000000000
@LockedMatchId = 00000000-0000-0000-0000-000000000000
@PlayerId = 00000000-0000-0000-0000-000000000000
@HomeTeamId = 00000000-0000-0000-0000-000000000000

# The round view. With no ?round= the server picks the round holding the earliest unfinished
# match (the last round once everything has finished). Carries the full ordered round list, the
# league's scored parameters, the caller's own forecast per match, canPredict, and — only when the
# league scores CorrectGoalScorer and the match is still open — that match's eligible scorers.
GET {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}/predictions
Accept: application/json

###

# One specific round. An unknown round name is 404.
GET {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}/predictions?round={{Round}}
Accept: application/json

###

# Save a round. Always 200 when the request itself is well-formed — the verdict per match is in
# "outcomes" (Saved | Locked | Invalid) and the refreshed round view comes back alongside it.
# Optional fields are accepted only when the league scores the matching parameter, and required
# when it does: send firstScorer* only for a CorrectGoalScorer league, totalCards only for
# CorrectCardCount, and so on.
POST {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}/predictions
Content-Type: application/json

{
  "items": [
    { "matchId": "{{MatchId}}", "homeScore": 2, "awayScore": 1 }
  ]
}

###

# A batch mixing a writable and an already-kicked-off match: expect Saved for the first and Locked
# for the second, with the first one still written. This is the lock proof — run it with a match
# whose kickoff an admin has just moved into the past.
POST {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}/predictions
Content-Type: application/json

{
  "items": [
    { "matchId": "{{MatchId}}", "homeScore": 1, "awayScore": 0 },
    { "matchId": "{{LockedMatchId}}", "homeScore": 3, "awayScore": 3 }
  ]
}

###

# An own-goal forecast: the goal is credited to the home team, the scorer plays for the away side.
# Accepted deliberately — the mismatch between the two picks *is* the own-goal signal.
POST {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}/predictions
Content-Type: application/json

{
  "items": [
    {
      "matchId": "{{MatchId}}",
      "homeScore": 1,
      "awayScore": 1,
      "firstScorerPlayerId": "{{PlayerId}}",
      "firstScorerTeamId": "{{HomeTeamId}}"
    }
  ]
}

###

# Half a scorer forecast — expect Invalid: a player with no credited team cannot be scored.
POST {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}/predictions
Content-Type: application/json

{
  "items": [
    { "matchId": "{{MatchId}}", "homeScore": 0, "awayScore": 0, "firstScorerPlayerId": "{{PlayerId}}" }
  ]
}

###

# Every member's forecasts for the round's matches that have kicked off. Matches before kickoff
# are absent from the response entirely — absence is what "not revealed yet" means.
GET {{PredictionLeague_HostAddress}}/api/leagues/{{LeagueId}}/predictions/revealed?round={{Round}}
Accept: application/json

###
